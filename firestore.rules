rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authorization: checks verified owner email or admins collection
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'thakorrahul8882@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidService(data) {
      return data.keys().hasAll(['id', 'category', 'gujaratiName', 'englishName', 'fee', 'active']) &&
        data.id is string && data.id.size() <= 64 &&
        data.category is string && data.category.size() <= 64 &&
        data.gujaratiName is string && data.gujaratiName.size() <= 150 &&
        data.englishName is string && data.englishName.size() <= 150 &&
        data.fee is number && data.fee >= 0 &&
        data.active is bool;
    }

    function isValidApplicationCreate(data) {
      return data.keys().hasAll(['applicationId', 'customerName', 'mobile', 'serviceId', 'serviceName', 'status', 'paymentStatus']) &&
        data.applicationId is string && data.applicationId.size() <= 64 &&
        data.customerName is string && data.customerName.size() <= 150 &&
        data.mobile is string && data.mobile.size() <= 15 &&
        data.serviceId is string && data.serviceId.size() <= 64 &&
        data.serviceName is string && data.serviceName.size() <= 150 &&
        data.status == 'SUBMITTED' &&
        (data.paymentStatus == 'PENDING' || data.paymentStatus == 'PAID');
    }

    // Services Catalog: Publicly readable for citizens, admin editable
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Government Schemes & Updates: Publicly readable, admin editable
    match /schemes/{schemeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Store Settings, Contact details, Visitor counter
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Citizen Applications: Publicly create & get by ID, and allow management by center
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId);
      allow list: if true;
      allow create: if isValidId(applicationId) && isValidApplicationCreate(incoming());
      allow update, delete: if true;
    }
  }
}
